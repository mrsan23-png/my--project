import random
import numpy as np
import matplotlib.pyplot as plt

# "I love you" in different languages
phrases = [
    "I love you", "Te amo", "Je t'aime", "Ich liebe dich", "Ti amo",
    "Eu te amo", "Seni seviyorum", "Aku cinta kamu", "Ami tomake bhalobashi",
    "Main tumse pyaar karta hoon", "Nakupenda", "Ik hou van je",
    "Kocham cie", "Mahal kita", "Jag älskar dig", "Te iubesc",
    "Szeretlek", "Rakastan sinua", "Volim te", "Aloha au ia oe",
]
colors = ["#ff1744", "#ff4081", "#f50057", "#ff80ab", "#e91e63", "#ff5252", "#ffffff"]

random.seed(7)
np.random.seed(7)

# Heart shape: (x^2 + y^2 - 1)^3 - x^2 * y^3 <= 0
def inside_heart(x, y):
    return (x**2 + y**2 - 1) ** 3 - x**2 * y**3 <= 0

fig, ax = plt.subplots(figsize=(9, 9), facecolor="black")
ax.set_facecolor("black")
ax.set_aspect("equal")
ax.axis("off")

# Heart outline
t = np.linspace(0, 2 * np.pi, 400)
hx = 16 * np.sin(t) ** 3
hy = 13 * np.cos(t) - 5 * np.cos(2 * t) - 2 * np.cos(3 * t) - np.cos(4 * t)
ax.plot(hx / 12, hy / 12, color="#ff1744", linewidth=3)

# Scatter phrases inside the heart without overlapping too much
placed = []
tries = 0
while len(placed) < 70 and tries < 20000:
    tries += 1
    x = random.uniform(-1.25, 1.25)
    y = random.uniform(-1.2, 1.3)
    if not inside_heart(x, y):
        continue
    if any((x - px) ** 2 + (y - py) ** 2 < 0.045 for px, py in placed):
        continue
    placed.append((x, y))
    ax.text(
        x, y, random.choice(phrases),
        color=random.choice(colors),
        fontsize=random.randint(6, 11),
        ha="center", va="center",
        rotation=random.randint(-25, 25),
        fontweight="bold",
    )

ax.set_xlim(-1.5, 1.5)
ax.set_ylim(-1.4, 1.5)
plt.tight_layout()
plt.savefig("love_heart.png", dpi=200, facecolor="black")
plt.show
